# ==============================================================================
# EMAIL AUTOMATION & REMINDER SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and update with your actual operational parameters.
# NEVER commit your '.env' file containing live secrets into version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & EXECUTION MODE SAFETY GUARDS
# ------------------------------------------------------------------------------
# Default is 'true' (Virtual Simulation Mode).
# In Simulation Mode, no SMTP connection is ever opened, and rendered emails
# are safely stored as local HTML preview artifacts.
SIMULATION_MODE=true

# Mandatory safety confirmation: Live delivery is strictly blocked unless set to 'true'
# or passed explicitly via CLI flag: --confirm-live
CONFIRM_LIVE_DELIVERY=false

# Default Timezone for campaign scheduling and audit logging (IANA timezone name)
DEFAULT_TIMEZONE=Asia/Kolkata

# Optional Database URL override (defaults to portable SQLite: sqlite:///./db/email.db)
# DATABASE_URL=sqlite:///./db/email.db

# ------------------------------------------------------------------------------
# 2. SMTP PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Hostname and Port of your SMTP server
# For Gmail: smtp.gmail.com on port 587 (STARTTLS) or port 465 (SSL)
# For SendGrid / Postmark / Mailgun: smtp.sendgrid.net, smtp.postmarkapp.com, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Authenticated SMTP User Account (typically your email address)
SMTP_USER=your_company_email@gmail.com

# Authenticated SMTP Password or App Password:
# NOTE FOR GMAIL ACCOUNTS:
# 1. You MUST enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate a dedicated 16-character "App Password":
#    https://myaccount.google.com/apppasswords
# 3. Select 'Mail' and device type, copy the generated 16-letter password below.
# 4. Do NOT use your regular personal Google account password!
SMTP_PASS=your_16_character_app_password

# Sender Identity headers
SMTP_FROM_EMAIL=your_company_email@gmail.com
SMTP_FROM_NAME=Email Automation System

# ------------------------------------------------------------------------------
# 3. DELIVERY RELIABILITY, RATE LIMITING & RETRIES
# ------------------------------------------------------------------------------
# Maximum number of messages dispatched per second (prevents provider throttling)
EMAIL_RATE_LIMIT_PER_SECOND=5.0

# Network timeout for socket connection and TLS handshake (in seconds)
SMTP_TIMEOUT_SECONDS=15

# Maximum retry attempts for temporary delivery errors (e.g., socket timeout, 421/450/451)
MAX_RETRIES=3

# Base delay in seconds for exponential backoff (e.g., attempt 1 = 60s, attempt 2 = 120s, attempt 3 = 240s)
RETRY_BACKOFF_BASE_SECONDS=60

# Background Worker Polling Interval (in seconds)
SCHEDULER_INTERVAL_SECONDS=10
