# ==========================================
# Email Automation & Reminder System Configuration
# Copy this file to .env and configure your values.
# NEVER commit the real .env file with passwords!
# ==========================================

# Set to 'true' for local safe testing without sending real emails (HTML previews saved)
# Set to 'false' to dispatch live emails via SMTP
DRY_RUN=true

# Sender Metadata
SENDER_NAME="Operations Reminder Desk"
SENDER_EMAIL="notifications@yourdomain.com"

# SMTP Provider Credentials
# For Gmail: Use smtp.gmail.com with a 16-character Google "App Password" (NOT your Google account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
